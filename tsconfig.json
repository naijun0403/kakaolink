{
  "compilerOptions": {
    "target": "es2020",
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmitOnError": true,
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": []
  },
  "include": [
    "src/**/*.ts"
  ]
}
