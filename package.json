{
  "name": "kakaolink",
  "version": "2.0.0-beta07",
  "description": "kakaolink (KakaoTalkShare) for messengerbot ",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs",
    "example": "example"
  },
  "scripts": {
    "build": "sh build.sh",
    "package:module": "node scripts/package-module.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "check": "pnpm run lint && pnpm run typecheck",
    "test": "pnpm run build && node --test"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naijun0403/kakaolink.git"
  },
  "keywords": [
    "kakaolink",
    "messengerbot",
    "kakaotalkshare"
  ],
  "author": "naijun0403",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/naijun0403/kakaolink/issues"
  },
  "homepage": "https://github.com/naijun0403/kakaolink#readme",
  "devDependencies": {
    "acorn": "^8.19.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  }
}
